# 基础域名（本地可先使用 *.localhost）
APP_DOMAIN=app.localhost
ADMIN_DOMAIN=admin.localhost
FILES_DOMAIN=files.localhost

# Nginx 反代到宿主机上的 Spring Boot 进程
HOST_APP_API_1=host.docker.internal:8081
HOST_APP_API_2=host.docker.internal:8082
HOST_ADMIN_API=host.docker.internal:8080
HOST_MINIO_API=minio:9000

# Common
TZ=Asia/Shanghai

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=root

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=rootroot
MINIO_BUCKET=lease
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
FITNESS_JWT_SECRET=please_set_a_32+_char_secret
FITNESS_AUTH_CAPTCHA_ENABLED=true
FITNESS_DEV_ENABLED=false

# RabbitMQ
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=root
RABBITMQ_DEFAULT_PASS=root
