        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleId\": {{scheduleId}}\n}"
        },
        "url": "{{appBaseUrl}}/app/booking/create"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('canRunBookingFlow') !== '1') {",
              "  postman.setNextRequest('08 Close Timeout Bookings');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "if (pm.collectionVariables.get('canRunBookingFlow') !== '1') {",
              "  pm.test('skip create booking when no available schedule', function () { pm.expect(true).to.eql(true); });",
              "} else if (res.code !== 200) {",
              "  pm.collectionVariables.set('canRunBookingFlow', '0');",
              "  pm.collectionVariables.unset('bookingId');",
              "  pm.test('booking create not available, skip pay chain', function () { pm.expect([200, 201]).to.include(res.code); });",
              "  postman.setNextRequest('08 Close Timeout Bookings');",
              "} else {",
              "  pm.test('create booking success', function () { pm.expect(res.code).to.eql(200); });",
              "  pm.test('bookingId exists', function () { pm.expect(res.data && res.data.bookingId).to.be.a('number'); });",
              "  pm.collectionVariables.set('bookingId', res.data.bookingId);",
              "  pm.collectionVariables.set('bookingPayNo', res.data.payNo);",
              "}"
            ]
          }
        }
      ]
    },
