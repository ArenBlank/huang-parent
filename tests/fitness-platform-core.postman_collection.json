    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const currentDate = now.toISOString().slice(0, 10);",
          "const checkinDate = new Date(now.getTime() + 86400000).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('currentDate', currentDate);",
          "pm.collectionVariables.set('checkinDate', checkinDate);"
        ]
      }
    }
  ],
