    {
      "name": "04 List Schedules",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{appAccessToken}}"
          }
        ],
        "url": "{{appBaseUrl}}/app/booking/schedule/list?coachId={{coachId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.test('schedule list api success', function () { pm.expect(res.code).to.eql(200); });",
              "const list = Array.isArray(res.data) ? res.data : [];",
              "const available = list.find(x => Number(x.bookedCount || 0) < Number(x.capacity || 0));",
              "if (available) {",
              "  pm.collectionVariables.set('scheduleId', available.id);",
              "  pm.collectionVariables.set('canRunBookingFlow', '1');",
              "  pm.test('has available schedule', function () { pm.expect(true).to.eql(true); });",
              "} else {",
              "  pm.collectionVariables.set('canRunBookingFlow', '0');",
              "  pm.collectionVariables.unset('bookingId');",
              "  pm.test('no available schedule -> skip booking flow', function () { pm.expect(true).to.eql(true); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{appAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
