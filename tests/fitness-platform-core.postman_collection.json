      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.test('biz code 200', function () { pm.expect(res.code).to.eql(200); });",
              "pm.test('accessToken exists', function () { pm.expect(res.data.accessToken).to.be.a('string').and.not.empty; });",
